# Portfolio Environment Variables
# Copy this file to .env and fill in your values

# SSL 인증서 파일명 (certificates 디렉토리 내의 파일)
KEY_PEM=cutwire.myddns.me-key.pem
CRT_PEM=cutwire.myddns.me-fullchain.pem

# Google Search Console 인증 코드 (선택사항)
GOOGLE_SITE_VERIFICATION=your_google_verification_code_here

# 포트 설정 (Docker 내부 포트)
PORT=8000

# 로그 레벨
LOG_LEVEL=INFO